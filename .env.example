# ─── Frontend Environment Variables Template ───────────────────────────
# Vite reads .env files from the PROJECT ROOT only (not from /src).
#
# Development:
#   Leave VITE_API_URL empty — the Vite dev server proxy (vite.config.js)
#   intercepts all /api/* requests and forwards them to http://localhost:5000.
#
# Production (Vercel):
#   Set VITE_API_URL to your deployed Render backend URL:
#   VITE_API_URL=https://startup-crm-backend-jahc.onrender.com
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=https://startup-crm-backend-jahc.onrender.com
