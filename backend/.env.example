# ─── Backend Environment Variables Template ────────────────────────────
# Configure these in your Render Dashboard (Environment tab) or local backend/.env
#
# Server Port (Render sets this automatically; defaults to 5000)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas Connection String (Secret)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# JWT Secret for Signing Authentication Tokens (Secret - min 32 chars recommended)
JWT_SECRET=your_jwt_secret_key_make_it_long_and_random

# JWT Expiration Duration (e.g., '7d', '24h', '30d')
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (Production Vercel URL)
# Multiple origins can be comma-separated: https://startup-crm-lite-drab.vercel.app,http://localhost:5173
FRONTEND_URL=https://startup-crm-lite-drab.vercel.app
